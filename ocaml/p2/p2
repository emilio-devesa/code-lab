(* Ejercicio 2 *)
(* Definiciones alternativas para: *)
(* abs *)
let abs_alt x = if x < 0 then x=-x else x;;

(* not *)
let not_alt x = false;;

(* max *)
let max_alt x,y = if x > y then x else y;;

(* min *)
let min_alt x,y = if x < y then x else y;;

(* string_of_bool *)
let string_of_bool_alt b = if b then "true" else "false";;

(* lowercase *)
let lowercase_alt c = char_of_int(int_of_char c + 32);;﻿


