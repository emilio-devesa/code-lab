(* Definir preorden *)
let rec preorden = function
	Empty -> raise (Invalid_argument "preorden")
	| Node (r,Empty,Empty) -> [r]
	| Node (r,i,Empty) -> r::(preorden i)
	| Node (r,Empty,d) -> r::(preorden d)
	| Node (r,i,d) -> r::(preorden i) @ (preorden d);;
(* val preorden : 'a bintree -> 'a list = <fun> *)


(* Definir postorden *)
let rec postorden = function
	Empty -> raise (Invalid_argument "postorden")
	| Node (r,Empty,Empty) -> [r]
	| Node (r,i,Empty) -> (postorden i) @ [r]
	| Node (r,Empty,d) -> (postorden d) @ [r]
	| Node (r,i,d) -> (postorden i) @ (postorden d) @ [r];;
(* val postorden : 'a bintree -> 'a list = <fun> *)


(* Definir inorden *)
let rec inorden = function
	Empty -> raise (Invalid_argument "inorden")
	| Node (r,Empty,Empty) -> [r]
	| Node (r,i,Empty) -> (inorden i) @ [r]
	| Node (r,Empty,d) -> r::(inorden d)
	| Node (r,i,d) -> (inorden i) @ r::(inorden d);;
(* val inorden : 'a bintree -> 'a list = <fun> *)


