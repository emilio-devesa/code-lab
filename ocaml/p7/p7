(* Ejercicio 2 *)
(* Definir arbolgen_of_bintree *)
let rec arbolgen_of_bintree = function
	Empty -> raise (Invalid_argument "arbolgen_of_bintree")
	| Node (r,Empty,Empty) -> Nodo (r,[])
	| Node (r,i,d) -> Nodo (r,[arbolgen_of_bintree i; arbolgen_of_bintree d]);;
(* val arbolgen_of_bintree : 'a bintree -> 'a arbolgen = <fun> *)


(* Definir bintree_of_arbolgen *)
let rec bintree_of_arbolgen = function
	Nodo (x,[]) -> Node (x,Empty,Empty)
	| Nodo (r, [i;d]) -> Node (r, bintree_of_arbolgen i, bintree_of_arbolgen d)
	| _ -> raise (Invalid_argument "bintree_of_arbolgen");;
(* val bintree_of_arbolgen : 'a arbolgen -> 'a bintree = <fun> *)
