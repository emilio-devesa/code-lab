#load "nums.cma";;
open Num;;

let fact n = if n = 0
			 then num_of_int 0
			 else let rec f (i, r) = if i = n
									 then num_of_int r
									 else f (i+1, r*(i+1))
				  in f (1,1);;
(* val fact : int -> Num.num = <fun> *)


let fib n = if n < 2
			then num_of_int n
			else let rec f (i, r, s) = 	if i = n
										then num_of_int (r+s)
										else f (i+1, r+s, r)
				 in f (2,1,0);;
(* val fib : int -> Num.num = <fun> *)


