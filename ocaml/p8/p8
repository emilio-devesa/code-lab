(* Ejercicio 2 *)
(* Definir comp con recursividad terminal *)
let comp l e = 
    let rec comp r = function
	      [] -> r
    	| h::t -> comp (h r) t
	in comp e (List.rev l);;
(* val comp : ('a -> 'a) list -> 'a -> 'a = <fun> *)



(* Ejercicio 3 *)
let rec monticulo a = match a with
		Leaf _ -> true
		|Node (ri, r, rd) -> (max ri rd <= Leaf r) && (monticulo ri && monticulo rd);;
(* val monticulo : 'a tree -> bool = <fun> *)
