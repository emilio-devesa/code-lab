let rec zip f = function
	([], l) -> l
	| (l, []) -> l
	| (h1::t1, h2::t2) -> f h1 h2::zip f (t1, t2);;
(* val zip : ('a -> 'a -> 'a) -> 'a list * 'a list -> 'a list = <fun> *)


