let rec fold f e = function
	[] -> e
	| h::t -> fold f (f e h) t;;
(* val fold : ('a -> 'b -> 'a) -> 'a -> 'b list -> 'a = <fun> *)


let rec cut l n = match (n,l) with
	(0,_) -> l
	|(n, h::t) -> cut t (n-1);;
(* val cut : 'a list -> int -> 'a list = <fun> *)


