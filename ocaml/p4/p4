(* Definir nprimeros: int -> int list*) 
let rec nprimeros = function
			  0 -> []
			| n -> nprimeros (n-1) @ [n];;


(* Definir una funcion from_to: int -> int -> int list*) 
let rec from_to m n= 
			if m > n then []
			else m :: from_to (m+1) n;;


(* Definir una funcion lmax: 'a list -> 'a
	   y una funcion lmin: 'a list -> 'a*) 
let rec lmax = function
			| [] -> failwith "lmax"
			| [x] -> x
			| h::t -> max h (lmax t);;
			
let rec lmin = function
			| [] -> failwith "lmin"
			| [x] -> x
			| h::t -> min h (lmin t);;


(* Definir una función rango:'a list ->'a * 'a*) 
let rango = function x -> (lmin x, lmax x);;


(* Definir una funcion ordenada: 'a list -> bool*) 
let rec ordenada = function
			[] | [_] -> true
			| h1::h2::t -> (h1 <= h2) && ordenada (h2::t);;


(* Definir una funcion del_fst: 'a -> 'a list -> 'a list*) 
let rec del_fst x = function
			[] -> []
			| h::t -> if h = x
					  then t
					  else h::(del_fst x t);;


(* Definir una funcion del_all: 'a -> 'a list -> 'a list*) 
let rec del_all x = function
			[] -> []
			| h::t -> if h = x
					  then del_all x t
					  else h::(del_all x t);;


(* Definir una funcion dif_1: 'a list -> 'a list -> 'a list*) 
let rec dif_1 a = function
			| [] -> a
			| h::t -> dif_1 (del_fst h a) t;;


(* Definir una funcion dif_2: 'a list -> 'a list -> 'a list*) 
let rec dif_2 a = function
			| [] -> a
			| h::t -> dif_2 (del_all h a) t;;
